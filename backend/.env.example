# Plantilla: exportar estas variables al proceso; Spring Boot no carga .env.
# Java local: URL JDBC tal como se utilizará, sin credenciales incluidas.
DB_URL=jdbc:mysql://localhost:3306/fixhub
DB_USERNAME=
DB_PASSWORD=
# Generar en privado al menos 32 bytes aleatorios codificados en Base64.
JWT_SECRET=
PORT=8080
JWT_EXPIRATION=PT1H
BOOTSTRAP_ROLES_ENABLED=true
BOOTSTRAP_ADMIN_ENABLED=false
# Completar solo si se habilita el administrador inicial en una base nueva.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Docker/Render: DB_URL sin parámetros; el entrypoint agrega VERIFY_CA.
# Montar el CA público como /etc/secrets/railway-ca.pem. Render proporciona PORT.
# Java remoto: configurar TLS y truststore en JDBC; no utiliza el entrypoint.
