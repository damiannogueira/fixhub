# =========================================================
# FixHub - .gitignore
# Java + Spring Boot + Maven + Vite + TypeScript + MySQL
# =========================================================


# ---------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# ---------------------------------------------------------
# IDEs y editores
# ---------------------------------------------------------

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
!.vscode/extensions.json

# Eclipse / Spring Tool Suite
.project
.classpath
.settings/
.springBeans
.sts4-cache/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/


# ---------------------------------------------------------
# Java / Spring Boot / Maven
# ---------------------------------------------------------

target/
*.class
*.jar
*.war
*.ear

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# No ignoramos:
# mvnw
# mvnw.cmd
# .mvn/wrapper/
# porque deben versionarse si se utiliza Maven Wrapper


# ---------------------------------------------------------
# Frontend / Node / Vite / TypeScript
# ---------------------------------------------------------

node_modules/

dist/
dist-ssr/

.vite/
.vite-cache/

*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/cache/
.yarn/unplugged/
.pnpm-store/


# ---------------------------------------------------------
# Variables de entorno y secretos
# ---------------------------------------------------------

.env
.env.*
!.env.example

# Configuraciones locales del backend
application-local.properties
application-local.yml
application-local.yaml

application-secret.properties
application-secret.yml
application-secret.yaml

# Claves y certificados
*.pem
*.key
*.p12
*.pfx
*.jks


# ---------------------------------------------------------
# Logs
# ---------------------------------------------------------

logs/
*.log
log/


# ---------------------------------------------------------
# Testing / coverage
# ---------------------------------------------------------

coverage/
.nyc_output/

test-results/
surefire-reports/
failsafe-reports/


# ---------------------------------------------------------
# Archivos temporales
# ---------------------------------------------------------

*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
*~
.cache/


# ---------------------------------------------------------
# Bases de datos locales
# ---------------------------------------------------------

*.db
*.sqlite
*.sqlite3


# ---------------------------------------------------------
# Archivos generados / comprimidos
# ---------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.rar