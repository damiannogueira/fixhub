    {
      "name": "Presupuestos",
      "description": "ADMINISTRADOR o RECEPCIONISTA gestionan y publican; TECNICO crea, edita o consulta solo en órdenes asignadas. Crear exige orden EN_DIAGNOSTICO. BORRADOR se edita en EN_DIAGNOSTICO; PUBLICADO se edita mientras la orden sigue PENDIENTE_APROBACION, sin republicar. CLIENTE exclusivo consulta los suyos y toma la decisión final. Publicar y decidir cambian también la orden. Aprobar y rechazar son alternativas irreversibles dentro del MVP; no ejecutar ambas sobre el mismo presupuesto. Presupuestar no modifica stock.",
      "item": [
        {
          "name": "Crear presupuesto borrador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"costoManoObra\": 15000.00,\n  \"detalles\": [{\"repuestoId\": {{repuestoId}}, \"cantidad\": 1}]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/presupuesto"
          }
        },
        {
          "name": "Buscar presupuesto por orden",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/presupuesto" }
        },
        {
          "name": "Listar presupuestos de gestión",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/presupuestos" }
        },
        {
          "name": "Listar presupuestos del técnico asignado",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/presupuestos/me" }
        },
        {
          "name": "Editar presupuesto pendiente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"costoManoObra\": 18000.00,\n  \"detalles\": [{\"repuestoId\": {{repuestoId}}, \"cantidad\": 2}]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/presupuestos/{{presupuestoId}}"
          }
        },
        {
          "name": "Publicar presupuesto",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/presupuestos/{{presupuestoId}}/publicar" }
        },
        {
          "name": "Listar presupuestos propios del cliente",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clientes/me/presupuestos" }
        },
        {
          "name": "Aprobar presupuesto propio",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
