          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"García López\",\n  \"dni\": \"30111222\",\n  \"direccion\": \"Av. Siempre Viva 456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
          }
        }
      ]
    },
    {
      "name": "Equipos",
      "description": "ADMINISTRADOR o RECEPCIONISTA para gestión; las consultas /me requieren CLIENTE y solo muestran sus equipos. Crear y actualizar modifican datos del equipo indicado.",
