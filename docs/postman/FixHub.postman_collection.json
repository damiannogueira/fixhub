    {
      "name": "Diagnóstico y registros técnicos",
      "description": "TECNICO crea o edita el diagnóstico en EN_DIAGNOSTICO y registra tareas en EN_REPARACION, siempre sobre sus órdenes asignadas. ADMINISTRADOR o RECEPCIONISTA consultan por /ordenes/{id}; TECNICO por /ordenes/me/{id}; CLIENTE por /clientes/me/ordenes/{id}. Las escrituras modifican el diagnóstico o agregan registros.",
      "item": [
        {
          "name": "Crear diagnóstico",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcionFalla\": \"Falla en la fuente de alimentación\",\n  \"tareasRequeridas\": \"Revisar fuente y componentes asociados\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/diagnostico"
          }
        },
        {
          "name": "Actualizar diagnóstico",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcionFalla\": \"Falla confirmada en la fuente\",\n  \"tareasRequeridas\": \"Reemplazar fuente y realizar pruebas\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/diagnostico"
          }
        },
